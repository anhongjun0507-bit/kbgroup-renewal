# =============================================================================
# Supabase 환경변수 (PHASE 1)
# =============================================================================
# 1. https://supabase.com 에서 프로젝트 생성
# 2. Dashboard → Project Settings → API 에서 아래 3개 값 복사
# 3. 이 파일을 `.env.local`로 복사한 뒤 실제 값으로 교체
#
# 주의: .env.local은 .gitignore 처리됨 → 커밋되지 않음.

# Project URL — Project Settings → API → Project URL
# 예: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Public Key — Project Settings → API → Project API keys → anon public
# 클라이언트(브라우저)에 노출되어도 안전 — RLS로 DB 보호.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service Role Key — Project Settings → API → Project API keys → service_role
# ⚠️ 절대 클라이언트에 노출 X. 서버 컴포넌트/Route Handler/Server Action 에서만 사용.
# RLS를 우회하므로 관리자 작업(글 작성·삭제 등)에 사용.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# CLI / API 토큰 (선택 — 배포·DB 마이그레이션 자동화용)
# =============================================================================
# Vercel Personal Access Token — https://vercel.com/account/tokens
# `vercel` CLI / Vercel REST API 인증에 사용.
VERCEL_TOKEN=your-vercel-personal-access-token

# Supabase Personal Access Token — https://supabase.com/dashboard/account/tokens
# `supabase` CLI / Management API 인증에 사용 (프로젝트 anon/service key와 다름).
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token
